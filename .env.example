# Copie para ".env" (que NÃO vai para o git) e ajuste os valores.
#   cp .env.example .env

# --- Autenticação de Usuários e Sessões ---
# Chave secreta para assinar cookies HMAC de sessão (se vazia, gerada automaticamente e persistida no banco)
APP_SECRET_KEY=
SESSION_TTL_DAYS=30

# Login com Google (Google Identity Services - Opcional)
# Crie um "OAuth 2.0 Client ID" (Aplicativo da Web) em https://console.cloud.google.com/apis/credentials
# Não precisa de Client Secret! Basta o Client ID público:
GOOGLE_CLIENT_ID=

# Autenticação HTTP Basic. Opcional (legado). Se configurado, exige senha antes de carregar o app.
# Gere uma senha forte com: python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_USERNAME=
APP_PASSWORD=

# Interface/porta publicadas no host. 127.0.0.1 = só acesso local / via reverse proxy.
BIND_ADDR=127.0.0.1
PORT=8000

# Imagem a usar (o deploy do GitHub Actions sobrescreve com o digest exato)
# IMAGE=ghcr.io/joaoaccioly-br/price-tracker:latest

# Banco de dados Neon (PostgreSQL na nuvem). Se vazio, usa SQLite local em data/tracker.db
DATABASE_URL=

# API oficial do Mercado Livre (evita bloqueios anti-bot/WAF)
# Modo 1: Renovação automática via OAuth (Recomendado para produção)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REFRESH_TOKEN=

# Modo 2: Token manual estático (válido por apenas 6 horas)
MERCADOLIVRE_TOKEN=

# --- Notificações de Alerta de Preço via Telegram (100% Gratuito & Instantâneo) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Username do bot no Telegram sem @ (ex: MeuPriceTrackerBot), usado para exibir instruções de link direto
TELEGRAM_BOT_USERNAME=

# --- API Oficial de Afiliados da Shopee Brasil (Shopee Affiliate Open API) ---
# Cadastre-se gratuitamente em https://affiliate.shopee.com.br/
# Obtenha seu App ID e App Secret em https://affiliate.shopee.com.br/open_api
# Permite consultar preços e ofertas da Shopee diretamente via API oficial, livre de bloqueios.
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# --- Google AI Studio (Gemini) - Descoberta Inteligente e Self-Healing Links ---
# Obtenha sua chave gratuita em https://aistudio.google.com/
# Habilita busca automática de ofertas na web (Search Grounding) e curadoria de links
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite



