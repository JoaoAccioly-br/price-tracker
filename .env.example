# Copie para ".env" (que NÃO vai para o git) e ajuste os valores.
#   cp .env.example .env

# Autenticação HTTP Basic. Obrigatório se o app ficar acessível pela internet.
# Gere uma senha forte com: python -c "import secrets; print(secrets.token_urlsafe(24))"
APP_USERNAME=
APP_PASSWORD=

# Interface/porta publicadas no host. 127.0.0.1 = só acesso local / via reverse proxy.
BIND_ADDR=127.0.0.1
PORT=8000

# Imagem a usar (o deploy do GitHub Actions sobrescreve com o digest exato)
# IMAGE=ghcr.io/joaoaccioly-br/price-tracker:latest

# Banco de dados Neon (PostgreSQL na nuvem). Se vazio, usa SQLite local em data/tracker.db
DATABASE_URL=

# API oficial do Mercado Livre (evita bloqueios anti-bot/WAF)
# Modo 1: Renovação automática via OAuth (Recomendado para produção)
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REFRESH_TOKEN=

# Modo 2: Token manual estático (válido por apenas 6 horas)
MERCADOLIVRE_TOKEN=

# --- Notificações de Alerta de Preço (Gratuito) ---
# Destinatário(s) dos avisos por e-mail (suporta múltiplos separados por vírgula)
# Exemplo: ALERT_EMAIL_TO=usuario1@gmail.com, usuario2@gmail.com
ALERT_EMAIL_TO=

# E-mail via SMTP (ex: Gmail com Senha de Aplicativo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app_16_digitos
SMTP_USE_SSL=false

# Notificações via Telegram Bot (Opcional - 100% gratuito e instantâneo)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

